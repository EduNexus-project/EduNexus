# =========================================================================
# SHT AI-ERP Beta (Team 3) - Environment Configuration Template
# =========================================================================
# Copy this file to .env for local development: cp .env.example .env
# For Vercel: Add these variables under Project Settings -> Environment Variables.
# NEVER commit your actual .env file with secrets to Git.

# 1. Google Gemini API (Server-side only, never exposed to client)
# Free recurring tier available at: https://aistudio.google.com/app/apikey (starts with AIzaSy)
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"

# 2. Optional Groq API Key (High-speed Llama 3.3 70B inference)
# Free tier available at: https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# 3. Supabase Cloud PostgreSQL & Auth (Optional - runs in full Demo Sandbox if omitted)
# Obtain from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# 4. Direct PostgreSQL Connection URI (Optional for pooling)
# Supabase Project Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# 5. Local Server Port (Default: 3000)
PORT=3000
NODE_ENV="production"
